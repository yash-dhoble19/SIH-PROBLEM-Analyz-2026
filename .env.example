# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# AI Provider Configuration (auto, anthropic, openai, gemini, heuristic)
AI_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# API Keys (Optional - offline NLP engine is used if omitted)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GITHUB_TOKEN=

# App Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# SIH Scraper Defaults
SIH_SOURCE_URL=https://www.sih.gov.in/sih2026PS
SIH_DB_PATH=data/sih_2026.db
